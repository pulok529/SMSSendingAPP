// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignChannel {
  SMS
  EMAIL
  BOTH
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SCHEDULED
  SENDING
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  SENDING
  SENT
  FAILED
}

enum DeviceStatus {
  ONLINE
  IDLE
  OFFLINE
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CLIENT
  SENDER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @default("")
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)
  company      String?
  phone        String?
  dateOfBirth  String?
  gender       String?
  address      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices       Device[]
  events        Event[]
  campaigns     Campaign[]
  customers     Customer[]
  templates     Template[]
  tickets       Ticket[]
  mobileLogs    MobileLog[]
  emailConfig   EmailConfig?
  contacts      Contact[]
  contactGroups ContactGroup[]
  messages      MessageLibrary[]
}

model EmailConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("SMTP")
  host      String   @default("smtp.gmail.com")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String   @default("")
  password  String   @default("")
  fromEmail String   @default("")
  fromName  String?  @default("Pulse Sender")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  contactNo String?
  email     String?
  others    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships GroupMember[]
}

model ContactGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  details   String?
  code      String?
  rank      Int?     // null = General, 1..N = Ranked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
}

model GroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([groupId, contactId])
}

model MessageLibrary {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  subject     String?
  body        String
  channel     CampaignChannel @default(SMS)
  type        String          @default("AUTO")   // AUTO | MANUAL
  status      String          @default("ACTIVE") // ACTIVE | DISABLED
  version     Int             @default(1)
  fromNumber  String?
  senderEmail String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Device {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName  String
  phoneNumber String
  operator    String
  status      DeviceStatus @default(OFFLINE)
  queuedJobs  Int          @default(0)
  battery     String?
  lastSeenAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Customer {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  company      String?
  mobile       String?
  email        String?    @unique
  city         String?
  tags         String[]
  eventCount   Int        @default(0)
  consentSms   Boolean    @default(false)
  consentEmail Boolean    @default(false)
  lastContact  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deliveries   Delivery[]
}

model Template {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String
  channel   CampaignChannel @default(SMS)
  body      String
  variables String[]        @default([])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Event {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  venue        String
  audience     String
  smsTemplate  String
  emailSubject String
  status       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  campaigns    Campaign[]
}

model Campaign {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name            String
  channel         CampaignChannel
  emailSubject    String?
  audienceSize    Int
  sentCount       Int             @default(0)
  failedCount     Int             @default(0)
  status          CampaignStatus  @default(DRAFT)
  scheduledAt     DateTime?
  saveToDirectory Boolean         @default(true)
  launchedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deliveries      Delivery[]
}

model Delivery {
  id             String          @id @default(cuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel        CampaignChannel
  status         DeliveryStatus  @default(PENDING)
  recipientPhone String?
  recipientEmail String?
  emailSubject   String?
  detail         String
  timestamp      DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Ticket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     String
  priority     String   @default("Medium")
  description  String
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MobileLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  type      String   @default("INFO")
  title     String
  detail    String
  timestamp DateTime @default(now())
}
